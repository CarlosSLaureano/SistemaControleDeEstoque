@model ProdutoModel
@{
    ViewData["Title"] = "Cadastrar produto";
}

@section BackgroundImage {
    <div class="cadastrar-background-image"></div>
}

<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="produto-box p-4 rounded shadow" style="max-width: 500px; width: 100%;">
        <div class="text-center mb-4">
            <h1 class="display-6">Cadastrar produto</h1>
        </div>

        <form asp-controller="Produto" asp-action="Criar" method="post">
            <div class="form-group mb-3">
                <label for="nome" class="form-label">Nome</label>
                <input type="text" asp-for="Nome" class="form-control" placeholder="Digite o nome do produto" />
                @Html.ValidationMessageFor(x => x.Nome)
            </div>
            <div class="form-group mb-3">
                <label for="descricao" class="form-label">Descrição</label>
                <input type="text" asp-for="Descricao" class="form-control" placeholder="Informe a descrição do produto" />
                @Html.ValidationMessageFor(x => x.Descricao)
            </div>
            <div class="form-group mb-3">
                <label for="preco" class="form-label">Preço</label>
                <input type="number" step="0.01" asp-for="Preco" class="form-control" placeholder="Informe o preço do produto" />
                @Html.ValidationMessageFor(x => x.Preco)
            </div>
            <div class="form-group mb-4">
                <label for="quantidade" class="form-label">Quantidade</label>
                <input type="number" asp-for="Quantidade" class="form-control" placeholder="Informe a quantidade do produto" />
                @Html.ValidationMessageFor(x => x.Quantidade)
            </div>

            <button type="submit" class="btn btn-primary w-100">Adicionar</button>
            <a class="btn btn-secondary w-100 mt-2" asp-controller="Produto" asp-action="Index" role="button">Voltar</a>
        </form>
    </div>
</div>
@section Scripts {
    <style>
        body {
            overflow: hidden;
        }

        .container {
            margin-top: -80px; /* Ajuste da margem superior para mover o formulário para cima */
        }
    </style>
}
