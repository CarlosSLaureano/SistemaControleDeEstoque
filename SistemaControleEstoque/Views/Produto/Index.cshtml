@model List<ProdutoModel>

@{
    ViewData["Title"] = "Listagem de produtos";

    // Calcula o total geral dos produtos
    decimal totalGeral = 0m;
    if (Model != null)
    {
        totalGeral = Model.Sum(p => (p.Preco ?? 0m) * (decimal)(p.Quantidade ?? 0));
    }
}



<div class="container mt-5">
    <div class="glass-container">

        <!-- Filtro por período -->
        <form method="get" asp-controller="Produto" asp-action="Index" class="row g-3 mb-4 align-items-end">
            <div class="col-md-3">
                <label for="dataInicio" class="form-label">Data Início:</label>
                <input type="date" id="dataInicio" name="dataInicio" value="@ViewBag.DataInicio" class="form-control" />
            </div>
            <div class="col-md-3">
                <label for="dataFim" class="form-label">Data Fim:</label>
                <input type="date" id="dataFim" name="dataFim" value="@ViewBag.DataFim" class="form-control" />
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter"></i> Filtrar
                </button>
            </div>
            <div class="col-md-2 d-grid">
                <a href="@Url.Action("Index", "Produto")" class="btn btn-secondary">
                    <i class="fas fa-broom"></i> Limpar Filtros
                </a>
            </div>
            <div class="col-md-2 d-grid">
                <a href="@Url.Action("ExportarParaExcel", "Produto", new { dataInicio = ViewBag.DataInicio, dataFim = ViewBag.DataFim })" class="btn btn-success">
                    <i class="fas fa-file-excel"></i> Exportar Excel
                </a>
            </div>
        </form>

        <!-- Botão para novo produto -->
        <div class="d-grid gap-2 d-md-flex justify-content-md-start mb-3">
            <a class="btn btn-primary" asp-controller="Produto" asp-action="Criar">
                <i class="fas fa-plus"></i> Adicionar novo produto
            </a>
        </div>

        <!-- Mensagens -->
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert alert-success text-center w-50 mx-auto" role="alert">
                @TempData["MensagemSucesso"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["MensagemErro"] != null)
        {
            <div class="alert alert-danger text-center w-50 mx-auto" role="alert">
                @TempData["MensagemErro"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Título -->
        <h1 class="display-6 text-center mt-4 mb-3 text-dark d-flex justify-content-center align-items-center">
            Listagem de produtos
            <i class="fas fa-box ms-2" style="color: #003366;"></i>
        </h1>

        <!-- Tabela de produtos -->
        <div class="table-responsive">
            <table id="table-produtos" class="table table-hover">
                <thead class="text-center" style="background-color: #003366; color: white;">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th class="text-start">Quantidade</th>
                        <th>Preço</th>
                        <th>Total (R$)</th>
                        <th>Data de Cadastro</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var produto in Model)
                        {
                            <tr>
                                <th>@produto.Id</th>
                                <td>@produto.Nome</td>
                                <td>@produto.Descricao</td>
                                <td class="text-start">@produto.Quantidade</td>
                                <td>@produto.Preco?.ToString("C")</td>
                                <td>@(((produto.Preco ?? 0m) * (decimal)(produto.Quantidade ?? 0)).ToString("C"))</td>
                                <td>@produto.DataCadastro?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <a class="btn btn-outline-primary btn-sm rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 35px; height: 35px;" title="Editar" asp-controller="Produto" asp-action="Editar" asp-route-id="@produto.Id">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <a href="#" class="btn btn-outline-danger btn-sm rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 35px; height: 35px;" title="Apagar" onclick="confirmDelete('@Url.Action("Apagar", "Produto", new { id = produto.Id })', '@(produto.Nome?.Replace("'", "\\'") ?? "")'); return false;">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="empty-state d-flex flex-column align-items-center">
                                    <i class="fas fa-box-open fa-4x text-muted mb-3" style="opacity: 0.3;"></i>
                                    <h4 class="text-muted fw-bold">Nenhum produto encontrado</h4>
                                    <p class="text-muted mb-4">Parece que você ainda não cadastrou nenhum produto.</p>
                                    <a class="btn btn-primary shadow-sm rounded-pill px-4" asp-controller="Produto" asp-action="Criar">
                                        <i class="fas fa-plus me-2"></i> Cadastrar Primeiro Produto
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="5" class="text-end">Total Geral:</th>
                        <th>@totalGeral.ToString("C")</th>
                        <th colspan="2"></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>


