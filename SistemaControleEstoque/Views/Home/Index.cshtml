@{
    ViewData["Title"] = "Página Inicial";
    var nomeUsuario = Context.Session.GetString("NomeUsuarioLogado") ?? "Usuário";
}

<div class="container-fluid py-4">
    <!-- Cabeçalho de Boas-vindas -->
    <div class="glass-container p-4 mb-4 d-flex justify-content-between align-items-center" style="border-left: 5px solid #003366;">
        <div>
            <h1 class="display-6 fw-bold mb-1" style="color: #1e293b; letter-spacing: -0.5px;">Olá, @nomeUsuario! 👋</h1>
            <p class="text-muted mb-0 fs-5">Bem-vindo(a) ao painel de controle do <strong>Gestor360</strong>.</p>
        </div>
        <div class="d-none d-md-block text-end">
            <p class="mb-0 text-muted fw-bold">@DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy")</p>
            <p class="mb-0 text-muted"><i class="fas fa-clock me-1"></i> @DateTime.Now.ToString("HH:mm")</p>
        </div>
    </div>

    <!-- Cards de Resumo -->
    <div class="row g-4 mb-5">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="glass-container p-4 h-100 d-flex flex-column justify-content-center align-items-center" style="transition: transform 0.3s ease; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="rounded-circle d-flex justify-content-center align-items-center mb-3" style="width: 60px; height: 60px; background-color: rgba(37, 99, 235, 0.1);">
                    <i class="fas fa-boxes fa-2x" style="color: #2563eb;"></i>
                </div>
                <h3 class="fw-bold mb-1" style="color: #1e293b;">@ViewBag.TotalProdutosEstoque</h3>
                <p class="text-muted mb-0 fw-medium">Produtos em Estoque</p>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="glass-container p-4 h-100 d-flex flex-column justify-content-center align-items-center" style="transition: transform 0.3s ease; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="rounded-circle d-flex justify-content-center align-items-center mb-3" style="width: 60px; height: 60px; background-color: rgba(16, 185, 129, 0.1);">
                    <i class="fas fa-users fa-2x" style="color: #10b981;"></i>
                </div>
                <h3 class="fw-bold mb-1" style="color: #1e293b;">@ViewBag.TotalClientes</h3>
                <p class="text-muted mb-0 fw-medium">Clientes Ativos</p>
            </div>
        </div>

        <div class="col-12 col-md-12 col-lg-4">
            <div class="glass-container p-4 h-100 d-flex flex-column justify-content-center align-items-center" style="transition: transform 0.3s ease; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="rounded-circle d-flex justify-content-center align-items-center mb-3" style="width: 60px; height: 60px; background-color: rgba(239, 68, 68, 0.1);">
                    <i class="fas fa-exclamation-triangle fa-2x" style="color: #ef4444;"></i>
                </div>
                <h3 class="fw-bold mb-1" style="color: #1e293b;">@ViewBag.ItensEmBaixa</h3>
                <p class="text-muted mb-0 fw-medium text-danger">Itens em Baixa</p>
            </div>
        </div>
    </div>

    <!-- Ações Rápidas -->
    <div class="row">
        <div class="col-12">
            <h4 class="mb-4 fw-bold" style="color: #1e293b;"><i class="fas fa-bolt text-warning me-2"></i>Ações Rápidas</h4>
            <div class="d-flex gap-3 flex-wrap">
                <a asp-controller="Produto" asp-action="Criar" class="btn btn-primary btn-lg rounded-pill shadow-sm d-flex align-items-center px-4" style="background: linear-gradient(135deg, #003366, #1e293b); border: none;">
                    <i class="fas fa-plus-circle me-2"></i> Novo Produto
                </a>
                <a asp-controller="Cliente" asp-action="Criar" class="btn btn-success btn-lg rounded-pill shadow-sm d-flex align-items-center px-4">
                    <i class="fas fa-user-plus me-2"></i> Novo Cliente
                </a>
                <a asp-controller="Categoria" asp-action="Criar" class="btn btn-secondary btn-lg rounded-pill shadow-sm d-flex align-items-center px-4">
                    <i class="fas fa-tag me-2"></i> Nova Categoria
                </a>
            </div>
        </div>
    </div>
</div>
