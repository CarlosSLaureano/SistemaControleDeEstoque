@model List<CategoriaModel>

@{
    ViewData["Title"] = "Listagem de categorias";
}



<div class="container mt-5">
    <div class="glass-container">
        <div class="d-grid gap-2 d-md-flex justify-content-md-start mb-3">
            <a class="btn btn-primary" role="button" asp-controller="Categoria" asp-action="Criar">Adicionar nova categoria</a>
        </div>

        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="d-flex justify-content-center">
                <div class="alert alert-success text-center w-50" role="alert">
                    @TempData["MensagemSucesso"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (TempData["MensagemErro"] != null)
        {
            <div class="d-flex justify-content-center">
                <div class="alert alert-danger text-center w-50" role="alert">
                    @TempData["MensagemErro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        <!-- Centralizando o título e o ícone -->
        <h1 class="display-6 text-center mt-4 mb-3 text-dark d-flex justify-content-center align-items-center">
            Listagem de Categorias
            <!-- Ícone de Categoria -->
            <i class="fas fa-tags ms-2" style="color: #0066CC;"></i>
        </h1>

        <div class="table-responsive mt-3">
            <table id="table-categorias" class="table table-hover">
                <thead class="">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Nome</th>
                        <th scope="col">Data de Cadastro</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (CategoriaModel categoria in Model)
                        {
                            <tr>
                                <th scope="row">@categoria.Id</th>
                                <td>@categoria.Nome</td>
                                <td>@categoria.DataCadastro</td>
                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <a class="btn btn-outline-primary btn-sm rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 35px; height: 35px;" title="Editar" asp-route-id="@categoria.Id" asp-controller="Categoria" asp-action="Editar">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <a href="#" class="btn btn-outline-danger btn-sm rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 35px; height: 35px;" title="Apagar" onclick="confirmDelete('@Url.Action("Apagar", "Categoria", new { id = categoria.Id })', '@(categoria.Nome?.Replace("'", "\\'") ?? "")'); return false;">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <div class="empty-state d-flex flex-column align-items-center">
                                    <i class="fas fa-tags fa-4x text-muted mb-3" style="opacity: 0.3;"></i>
                                    <h4 class="text-muted fw-bold">Nenhuma categoria encontrada</h4>
                                    <p class="text-muted mb-4">Parece que você ainda não cadastrou nenhuma categoria.</p>
                                    <a class="btn btn-primary shadow-sm rounded-pill px-4" asp-controller="Categoria" asp-action="Criar">
                                        <i class="fas fa-plus me-2"></i> Cadastrar Primeira Categoria
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


