@model List<CategoriaModel>

@{
    ViewData["Title"] = "Listagem de categorias";
}

@section BackgroundImage {
    <div class="categoria-background-image"></div>
}

<div class="container mt-5">
    <div class="categorias-wrapper">
        <div class="d-grid gap-2 d-md-flex justify-content-md-start mb-3">
            <a class="btn btn-primary" role="button" asp-controller="Categoria" asp-action="Criar">Adicionar nova categoria</a>
        </div>

        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="d-flex justify-content-center">
                <div class="alert alert-success text-center w-50" role="alert">
                    @TempData["MensagemSucesso"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (TempData["MensagemErro"] != null)
        {
            <div class="d-flex justify-content-center">
                <div class="alert alert-danger text-center w-50" role="alert">
                    @TempData["MensagemErro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        <!-- Centralizando o título e o ícone -->
        <h1 class="display-6 text-center mt-4 mb-3 text-dark d-flex justify-content-center align-items-center">
            Listagem de Categorias
            <!-- Ícone de Categoria -->
            <i class="fas fa-tags ms-2" style="color: #0066CC;"></i>
        </h1>

        <div class="table-responsive mt-3">
            <table id="table-categorias" class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Nome</th>
                        <th scope="col">Data de Cadastro</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (CategoriaModel categoria in Model)
                        {
                            <tr>
                                <th scope="row">@categoria.Id</th>
                                <td>@categoria.Nome</td>
                                <td>@categoria.DataCadastro</td>
                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <a role="button" class="btn btn-primary btn-sm" asp-route-id="@categoria.Id" asp-controller="Categoria" asp-action="Editar">Editar</a>
                                        <a role="button" class="btn btn-danger btn-sm" asp-route-id="@categoria.Id" asp-controller="Categoria" asp-action="ApagarConfirmacao">Apagar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center">Nenhuma categoria encontrada</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
