@model CategoriaModel

@{
    ViewData["Title"] = "Editar categoria";
}



<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="glass-container p-4 rounded shadow" style="max-width: 600px; width: 100%;">
        <div class="text-center mb-4">
            <h1 class="display-6">Editar categoria</h1>
        </div>

        <form asp-controller="Categoria" asp-action="" method="post">
            <div class="form-group mb-3">
                <label asp-for="Nome" class="form-label">Nome</label>
                <input asp-for="Nome" class="form-control" placeholder="Digite o nome da categoria" />
                <span class="text-danger">@Html.ValidationMessageFor(x => x.Nome)</span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Editar</button>
            <a asp-controller="Categoria" asp-action="Index" class="btn btn-secondary w-100 mt-2">Voltar</a>
        </form>
    </div>
</div>
@section Scripts {
    <style>

        body {
            overflow: hidden;
        }

        .container {
            margin-top: -80px; /* Ajuste da margem superior para mover o formulário para cima */
        }
    </style>
}

