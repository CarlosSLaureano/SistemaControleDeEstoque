@model UsuarioModel

<div class="sidebar-glass">
    <div class="list-group list-group-flush">
        
        <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="fas fa-home"></i> <span class="menu-text">Olá, @Model.Nome</span>
        </a>

        <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Produto" asp-action="Index">
            <i class="fas fa-box"></i> <span class="menu-text">Produtos</span>
        </a>

        <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Cliente" asp-action="Index">
            <i class="fas fa-users"></i> <span class="menu-text">Clientes</span>
        </a>

        @if (Model.Perfil == SistemaControleEstoque.Enums.PerfilEnum.Administrador)
        {
            <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Usuario" asp-action="Index">
                <i class="fas fa-user-shield"></i> <span class="menu-text">Usuários</span>
            </a>

            <a class="list-group-item list-group-item-action" asp-area="" asp-controller="ActivityLogs" asp-action="Index">
                <i class="fas fa-history"></i> <span class="menu-text">Atividades</span>
            </a>

            <a class="list-group-item list-group-item-action" asp-area="" asp-controller="AlterarSenha" asp-action="Index">
                <i class="fas fa-key"></i> <span class="menu-text">Alterar Senha</span>
            </a>
        }

        <a class="list-group-item list-group-item-action text-danger" asp-area="" asp-controller="Login" asp-action="Sair">
            <i class="fas fa-sign-out-alt"></i> <span class="menu-text">Sair</span>
        </a>

    </div>
</div>

