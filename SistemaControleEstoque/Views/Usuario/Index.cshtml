@model List<UsuarioModel>

@{
    ViewData["Title"] = "Listagem de usuários";
    var tipoUsuario = Context.Session.GetString("TipoUsuario");
}



<div class="container mt-5">
    <div class="glass-container">

        <!-- Filtro por período -->
        <form method="get" asp-controller="Usuario" asp-action="Index" class="row g-3 mb-4 align-items-end">
            <div class="col-lg-2 col-md-6">
                <label for="dataInicio" class="form-label">Data Início:</label>
                <input type="date" id="dataInicio" name="dataInicio" value="@ViewBag.DataInicio" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label for="dataFim" class="form-label">Data Fim:</label>
                <input type="date" id="dataFim" name="dataFim" value="@ViewBag.DataFim" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-3 d-grid">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter"></i> Filtrar
                </button>
            </div>
            <div class="col-lg-2 col-md-3 d-grid">
                <a href="@Url.Action("Index", "Usuario")" class="btn btn-secondary">
                    <i class="fas fa-broom"></i> Limpar Filtros
                </a>
            </div>
            <div class="col-lg-2 col-md-3 d-grid">
                <a href="@Url.Action("ExportarParaExcel", "Usuario", new { dataInicio = ViewBag.DataInicio, dataFim = ViewBag.DataFim })" class="btn btn-success">
                    <i class="fas fa-file-excel"></i> Exportar Excel
                </a>
            </div>
            <div class="col-lg-2 col-md-3 d-grid">
                <a href="@Url.Action("ExportarParaPdf", "Usuario", new { dataInicio = ViewBag.DataInicio, dataFim = ViewBag.DataFim })" class="btn btn-danger">
                    <i class="fas fa-file-pdf"></i> Exportar PDF
                </a>
            </div>
        </form>

        <!-- Botões alinhados -->
        <div class="d-flex justify-content-between mb-3">
            <a class="btn btn-primary" role="button" asp-controller="Usuario" asp-action="Criar">
                <i class="fas fa-plus me-1"></i> Adicionar novo usuário
            </a>
        </div>

        <!-- Mensagens de sucesso/erro -->
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="d-flex justify-content-center">
                <div class="alert alert-success text-center w-50" role="alert">
                    @TempData["MensagemSucesso"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (TempData["MensagemErro"] != null)
        {
            <div class="d-flex justify-content-center">
                <div class="alert alert-danger text-center w-50" role="alert">
                    @TempData["MensagemErro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        <!-- Título -->
        <h1 class="display-6 text-center mt-4 mb-3 text-dark">
            Listagem de usuários
            <i class="fas fa-users ms-2" style="color: #003366;"></i>
        </h1>

        <!-- Tabela -->
        <div class="table-responsive">
            <table id="table-usuarios" class="table table-hover">
                <thead class="text-center" style="background-color: #003366; color: white;">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Login</th>
                        <th>E-mail</th>
                        <th>Perfil</th>
                        <th>Data de Cadastro</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var usuario in Model)
                        {
                            <tr>
                                <th class="text-center">@usuario.Id</th>
                                <td>@usuario.Nome</td>
                                <td>@usuario.Login</td>
                                <td>@usuario.Email</td>
                                <td>@(usuario.Perfil == SistemaControleEstoque.Enums.PerfilEnum.Administrador ? "Administrador" : "Padrão")</td>
                                <td>@usuario.DataCadastro?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <a class="btn btn-outline-primary btn-sm rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 35px; height: 35px;" title="Editar" asp-route-id="@usuario.Id" asp-controller="Usuario" asp-action="Editar">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        @if (tipoUsuario == "Administrador")
                                        {
                                            <a class="btn btn-outline-warning btn-sm rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 35px; height: 35px;" title="Alterar Senha" asp-action="AlterarSenha" asp-route-id="@usuario.Id">
                                                <i class="fas fa-key"></i>
                                            </a>
                                        }
                                        <a href="#" class="btn btn-outline-danger btn-sm rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 35px; height: 35px;" title="Apagar" onclick="confirmDelete('@Url.Action("Apagar", "Usuario", new { id = usuario.Id })', '@(usuario.Nome?.Replace("'", "\\'") ?? "")'); return false;">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="empty-state d-flex flex-column align-items-center">
                                    <i class="fas fa-users-slash fa-4x text-muted mb-3" style="opacity: 0.3;"></i>
                                    <h4 class="text-muted fw-bold">Nenhum usuário encontrado</h4>
                                    <p class="text-muted mb-4">Parece que você ainda não cadastrou nenhum usuário.</p>
                                    <a class="btn btn-primary shadow-sm rounded-pill px-4" asp-controller="Usuario" asp-action="Criar">
                                        <i class="fas fa-plus me-2"></i> Cadastrar Primeiro Usuário
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


