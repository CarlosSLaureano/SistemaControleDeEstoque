@model ClienteModel
@{
    ViewData["Title"] = "Confirmação apagar o cliente";
}

@section BackgroundImage {
    <div class="cliente-background-image"></div>
}

<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="produto-box p-4 rounded shadow text-center" style="max-width: 500px; width: 100%;">
        <h3 class="mb-4">Realmente deseja apagar o cliente <strong>@Model.Nome</strong>?</h3>

        <a class="btn btn-primary w-100 mb-2" asp-action="Index" asp-controller="Cliente" role="button">
            Cancelar exclusão
        </a>
        <a class="btn btn-danger w-100" asp-action="Apagar" asp-controller="Cliente" asp-route-id="@Model.Id" role="button">
            Confirmar exclusão
        </a>
    </div>
</div>
@section Scripts {
    <style>
        body {
            overflow: hidden;
        }

        .container {
            margin-top: -80px; /* Ajuste da margem superior para mover o formulário para cima */
        }
    </style>
}
