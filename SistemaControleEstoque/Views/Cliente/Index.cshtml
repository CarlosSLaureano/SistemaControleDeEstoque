@model List<ClienteModel>

@{
    ViewData["Title"] = "Listagem de clientes";
}

@section BackgroundImage {
    <div class="cliente-background-image"></div>
}

<div class="container mt-5">
    <div class="clientes-wrapper">

        <!-- Filtro por data de nascimento -->
        <form method="get" asp-controller="Cliente" asp-action="Index" class="row g-3 mb-4 align-items-end">
            <div class="col-md-3">
                <label for="dataInicio" class="form-label">Data Início:</label>
                <input type="date" id="dataInicio" name="dataInicio" value="@ViewBag.DataInicio" class="form-control" />
            </div>
            <div class="col-md-3">
                <label for="dataFim" class="form-label">Data Fim:</label>
                <input type="date" id="dataFim" name="dataFim" value="@ViewBag.DataFim" class="form-control" />
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter"></i> Filtrar
                </button>
            </div>
            <div class="col-md-2 d-grid">
                <a href="@Url.Action("Index", "Cliente")" class="btn btn-secondary">
                    <i class="fas fa-broom"></i> Limpar Filtros
                </a>
            </div>
            <div class="col-md-2 d-grid">
                <a href="@Url.Action("ExportarParaExcel", "Cliente", new { dataInicio = ViewBag.DataInicio, dataFim = ViewBag.DataFim })" class="btn btn-success">
                    <i class="fas fa-file-excel"></i> Exportar Excel
                </a>
            </div>
        </form>

        <!-- Botão para novo cliente -->
        <div class="d-grid gap-2 d-md-flex justify-content-md-start mb-3">
            <a class="btn btn-primary" asp-controller="Cliente" asp-action="Criar">
                <i class="fas fa-plus"></i> Adicionar novo cliente
            </a>
        </div>

        <!-- Mensagens -->
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert alert-success text-center w-50 mx-auto" role="alert">
                @TempData["MensagemSucesso"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["MensagemErro"] != null)
        {
            <div class="alert alert-danger text-center w-50 mx-auto" role="alert">
                @TempData["MensagemErro"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Título -->
        <h1 class="display-6 text-center mt-4 mb-3 text-dark d-flex justify-content-center align-items-center">
            Listagem de clientes
            <i class="fas fa-users ms-2" style="color: #003366;"></i>
        </h1>

        <!-- Tabela de clientes -->
        <div class="table-responsive">
            <table id="table-clientes" class="table table-striped table-hover">
                <thead class="text-center" style="background-color: #003366; color: white;">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Telefone</th>
                        <th>Data Nascimento</th>
                        <th>Data Cadastro</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cliente in Model)
                        {
                            var telefoneFormatado = string.Empty;
                            if (!string.IsNullOrEmpty(cliente.Telefone))
                            {
                                telefoneFormatado = new string(cliente.Telefone.Where(char.IsDigit).ToArray());
                                if (!telefoneFormatado.StartsWith("55"))
                                {
                                    telefoneFormatado = "55" + telefoneFormatado;
                                }
                            }

                            <tr>
                                <th>@cliente.Id</th>
                                <td>@cliente.Nome</td>
                                <td>@cliente.Email</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(telefoneFormatado))
                                    {
                                        <a href="https://wa.me/@telefoneFormatado" target="_blank" class="text-decoration-none text-dark">
                                            <i class="fab fa-whatsapp text-success me-1"></i>@cliente.Telefone
                                        </a>
                                    }
                                    else
                                    {
                                        @cliente.Telefone
                                    }
                                </td>
                                <td>@cliente.DataNascimento?.ToString("dd/MM/yyyy")</td>
                                <td>@cliente.DataCadastro?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <a class="btn btn-primary btn-sm" asp-controller="Cliente" asp-action="Editar" asp-route-id="@cliente.Id">Editar</a>
                                        <a class="btn btn-danger btn-sm" asp-controller="Cliente" asp-action="ApagarConfirmacao" asp-route-id="@cliente.Id">Apagar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">Nenhum cliente encontrado</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
