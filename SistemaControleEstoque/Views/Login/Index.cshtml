@model LoginModel
@{
    Layout = "_LayoutDeslogado";
    ViewData["Title"] = "Login";
}

@if (TempData["MensagemErro"] != null)
{
    <div class="d-flex justify-content-center">
        <div class="alert alert-danger text-center w-50" role="alert">
            @TempData["MensagemErro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (TempData["MensagemSucesso"] != null)
{
    <div class="d-flex justify-content-center">
        <div class="alert alert-success text-center w-50" role="alert">
            @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}


<div class="container d-flex justify-content-center align-items-center flex-grow-1">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4 p-5 rounded-4 shadow-lg glass-container" style="backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.4);">
        <div class="text-center mb-5">
            <i class="fas fa-boxes fa-3x mb-3" style="color: #003366;"></i>
            <h2 class="fw-bold" style="color: #1e293b; letter-spacing: -0.5px;">Gestor360</h2>
            <p class="text-muted" style="font-size: 0.95rem;">Faça login para gerenciar seu estoque</p>
        </div>

        <form asp-controller="Login" asp-action="Entrar" method="post" id="loginForm">
            <div class="mb-4">
                <div class="input-group input-group-lg shadow-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 10px 0 0 10px;">
                        <i class="fas fa-user ms-2"></i>
                    </span>
                    <input type="text" asp-for="Login" class="form-control border-start-0 ps-2" id="login" placeholder="Usuário" style="border-radius: 0 10px 10px 0; font-size: 1rem; background-color: white !important;">
                </div>
                <div class="text-danger mt-1" style="font-size: 0.85rem;">
                    @Html.ValidationMessageFor(x => x.Login)
                </div>
            </div>

            <div class="mb-4">
                <div class="input-group input-group-lg shadow-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 10px 0 0 10px;">
                        <i class="fas fa-lock ms-2"></i>
                    </span>
                    <input type="password" asp-for="Senha" class="form-control border-start-0 ps-2" id="senha" placeholder="Senha" style="border-radius: 0 10px 10px 0; font-size: 1rem; background-color: white !important;">
                </div>
                <div class="text-danger mt-1" style="font-size: 0.85rem;">
                    @Html.ValidationMessageFor(x => x.Senha)
                </div>
            </div>

            <p class="mb-4 text-end">
                <a asp-action="RedefinirSenha" asp-controller="Login" class="text-decoration-none" style="color: #003366; font-size: 0.9rem; font-weight: 500;">
                    Esqueceu sua senha?
                </a>
            </p>

            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm fw-bold d-flex align-items-center justify-content-center gap-2" id="btnLogin" style="background-color: #003366; border-color: #003366; transition: all 0.3s ease; height: 52px;">
                <span id="btnLoginText">Entrar no Sistema</span>
                <span id="btnLoginSpinner" class="d-none">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    Aguarde...
                </span>
            </button>
        </form>
    </div>
</div>


@section Scripts {
    <style>
        /* Remover a barra de rolagem */
        body {
            overflow: hidden;
        }
        #btnLogin:disabled {
            opacity: 0.85;
            cursor: not-allowed;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('loginForm');
            const loginButton = document.getElementById('btnLogin');
            const btnText = document.getElementById('btnLoginText');
            const btnSpinner = document.getElementById('btnLoginSpinner');

            form.addEventListener('submit', function () {
                // Esconde texto, mostra spinner inline
                btnText.classList.add('d-none');
                btnSpinner.classList.remove('d-none');
                // Desabilita botao
                loginButton.disabled = true;
            });
        });
    </script>
}

