@model LoginModel
@{
    Layout = "_LayoutDeslogado";
    ViewData["Title"] = "Login";
}

@if (TempData["MensagemErro"] != null)
{
    <div class="d-flex justify-content-center">
        <div class="alert alert-danger text-center w-50" role="alert">
            @TempData["MensagemErro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (TempData["MensagemSucesso"] != null)
{
    <div class="d-flex justify-content-center">
        <div class="alert alert-success text-center w-50" role="alert">
            @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}


<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh; margin-top: -100px;">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4 p-3 border rounded shadow login-box">
        <form asp-controller="Login" asp-action="Entrar" method="post" id="loginForm">
            <div class="mb-2">
                <label for="login" class="form-label">Login:</label>
                <input type="text" asp-for="Login" class="form-control" id="login">
                @Html.ValidationMessageFor(x => x.Login)
            </div>
            <div class="mb-2">
                <label for="senha" class="form-label">Senha:</label>
                <input type="password" asp-for="Senha" class="form-control" id="senha">
                @Html.ValidationMessageFor(x => x.Senha)
            </div>

            <p class="mb-3 text-center">
                Esqueceu sua senha?<br>
                <a asp-action="RedefinirSenha" asp-controller="Login" class="text-danger fw-bold" style="text-decoration: none;">Redefinir minha senha</a>
            </p>

            <button type="submit" class="btn btn-primary w-100" id="btnLogin">Entrar</button>
        </form>
    </div>
</div>

<!-- Spinner de carregamento (invisível até envio do formulário) -->
<div id="loadingSpinner" class="d-none position-fixed top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-flex justify-content-center align-items-center" style="z-index: 9999;">
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
        <p class="mt-2 fw-bold text-primary">Aguarde...</p>
    </div>
</div>

@section Scripts {
    <style>
        /* Remover a barra de rolagem */
        body {
            overflow: hidden;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('loginForm');
            const spinner = document.getElementById('loadingSpinner');
            const loginButton = document.getElementById('btnLogin');

            form.addEventListener('submit', function () {
                // Exibe spinner
                spinner.classList.remove('d-none');
                // Desabilita botão
                loginButton.disabled = true;
                loginButton.innerText = 'Aguarde...';
            });
        });
    </script>
}
