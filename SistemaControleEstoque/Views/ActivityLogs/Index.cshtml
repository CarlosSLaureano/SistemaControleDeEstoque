@model List<SistemaControleEstoque.Models.ActivityLog>

@using System

@{
    ViewData["Title"] = "Registro de Atividades";
    var tipoUsuario = Context.Session.GetString("TipoUsuario") ?? "";
    string dataInicio = Context.Request.Query["dataInicio"];
    string dataFim = Context.Request.Query["dataFim"];
}

<div class="container mt-5 glass-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-dark"><i class="fas fa-clipboard-list"></i> Registro de Atividades</h2>

        @if (tipoUsuario.Equals("Administrador", StringComparison.OrdinalIgnoreCase))
        {
            <form method="get" asp-controller="ActivityLogs" asp-action="ExportarParaExcel" class="d-flex gap-2 align-items-center">
                <input type="date" name="dataInicio" class="form-control" value="@dataInicio" required />
                <input type="date" name="dataFim" class="form-control" value="@dataFim" required />
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-file-excel"></i> Exportar Excel
                </button>
            </form>
        }
    </div>

    <form method="get" asp-controller="ActivityLogs" asp-action="Index" class="row mb-4 g-2">
        <div class="col-md-4">
            <input type="date" name="dataInicio" class="form-control" placeholder="Data Início" value="@dataInicio" />
        </div>
        <div class="col-md-4">
            <input type="date" name="dataFim" class="form-control" placeholder="Data Fim" value="@dataFim" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-filter me-1"></i>Filtrar
            </button>
            <a asp-controller="ActivityLogs" asp-action="Index" class="btn btn-secondary w-100">
                <i class="fas fa-broom me-1"></i>Limpar Filtros
            </a>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table ">
                <thead class="">
                    <tr>
                        <th>Usuário</th>
                        <th>Ação</th>
                        <th>Controller</th>
                        <th>Descrição</th>
                        <th>Quantidade</th>
                        <th>Data/Hora</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.UserName</td>
                            <td>@log.Action</td>
                            <td>@log.Controller</td>
                            <td>@log.Description</td>
                            <td>@log.Quantidade</td>
                            <td>@log.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            Nenhum registro de atividade encontrado.
        </div>
    }
</div>




